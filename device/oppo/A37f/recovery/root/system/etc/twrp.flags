# Flag tambahan TWRP untuk partisi yang tidak ada di recovery.fstab.
# Partisi khas OPPO -- disalin dari twrp.fstab basis 9.0.

/aboot          emmc    /dev/block/bootdevice/by-name/aboot         flags=display="ABoot";backup=1
/logo           emmc    /dev/block/bootdevice/by-name/LOGO          flags=display="LOGO";backup=1
/modem_st1      emmc    /dev/block/bootdevice/by-name/modemst1      flags=display="MODEM1";backup=1
/modem_st2      emmc    /dev/block/bootdevice/by-name/modemst2      flags=display="MODEM2";backup=1
/driver         emmc    /dev/block/bootdevice/by-name/DRIVER        flags=display="DRIVER";backup=1
/reserve4       emmc    /dev/block/bootdevice/by-name/reserve4      flags=display="RESERVE4";backup=1
/oppodycnvbk    emmc    /dev/block/bootdevice/by-name/oppodycnvbk   flags=display="OPPODYCNVBK";backup=1
/static_nv_bk   emmc    /dev/block/bootdevice/by-name/oppostanvbk   flags=display="OPPOSTANVBK";backup=1
/fsg            emmc    /dev/block/bootdevice/by-name/fsg           flags=display="Efs";backup=1
/oem            emmc    /dev/block/bootdevice/by-name/oem           flags=display="OEM";backup=1
/external_sd    auto    /dev/block/mmcblk1p1                        flags=display="Micro SDCard";storage;wipeingui;removable
